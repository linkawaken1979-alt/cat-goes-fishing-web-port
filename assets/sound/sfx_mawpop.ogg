<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="theme-color" content="#0b0e11" />
  <meta name="description" content="Cat Goes Fishing. Cast a line, explore the ocean and discover its fish." />
  <title>Cat Goes Fishing</title>
  <link rel="icon" type="image/png" href="./favicon.png" />
  <link rel="apple-touch-icon" href="./favicon.png" />
  <meta property="og:title" content="Cat Goes Fishing" />
  <meta property="og:description" content="A cat, a fishing rod, and an ocean to explore." />
  <meta property="og:type" content="website" />
  <style>
    html,body{margin:0;padding:0;background:#0b0e11;height:100%;overflow:hidden}
    canvas{display:block;margin:0 auto}
    #cgf-loading{position:fixed;inset:0;z-index:100;display:grid;place-items:center;
      background:#0b0e11;color:#eeeae0;font-family:"Segoe UI",system-ui,sans-serif;
      -webkit-font-smoothing:antialiased;opacity:1;transition:opacity .3s ease}
    #cgf-loading.cgf-done{opacity:0;pointer-events:none}
    .cgf-mark{display:flex;flex-direction:column;align-items:center;margin-top:-5vh;animation:breathe 3.2s ease-in-out infinite}
    .cgf-emblem{width:150px;height:112px;margin-bottom:22px;color:#d9e0da}
    .cgf-title{margin:0;text-align:center;font-size:clamp(36px,5vw,60px);font-weight:650;line-height:1.05;letter-spacing:-.055em}
    .cgf-title span{display:block;margin-bottom:8px;font-size:13px;line-height:1.3;font-weight:500;letter-spacing:.32em;text-transform:uppercase}
    .cgf-title em{font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:-.035em}
    .cgf-progress{position:absolute;bottom:clamp(64px,12vh,140px);left:50%;transform:translateX(-50%);width:min(360px,calc(100vw - 64px))}
    .cgf-bar{height:4px;border-radius:4px;background:#ffffff16;overflow:hidden}
    .cgf-fill{height:100%;width:0;background:#d9e0da;border-radius:inherit;transition:width .25s ease-out}
    .cgf-detail{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-top:16px;color:#929b9f;font-size:12px;line-height:1.5}
    .cgf-detail p{margin:0}.cgf-percent{font-variant-numeric:tabular-nums;color:#8a969d}
    .cgf-error{font-size:13px;line-height:1.5;color:#dcc3b0;margin:14px 0 0}
    .cgf-retry{margin-top:14px;padding:8px 16px;border:1px solid #ffffff30;border-radius:4px;background:transparent;color:#eeeae0;font:inherit;font-size:13px;cursor:pointer}
    .cgf-retry:focus-visible{outline:2px solid #d9e0da;outline-offset:4px}
    .cgf-credit{position:absolute;bottom:max(20px,env(safe-area-inset-bottom));color:#7d8b93;font-size:11px;text-decoration:none}
    .cgf-credit:hover,.cgf-credit:focus-visible{color:#eeeae0;text-decoration:underline}
    @keyframes breathe{0%,100%{opacity:.65}50%{opacity:1}}
    @media(max-height:480px){.cgf-mark{margin-top:-48px;animation:none}.cgf-emblem{width:80px;height:60px;margin-bottom:8px}.cgf-title{font-size:34px}.cgf-progress{bottom:40px}.cgf-credit{bottom:12px}}
    @media(prefers-reduced-motion:reduce){#cgf-loading,.cgf-fill{transition:none}.cgf-mark{animation:none}}
    @media(max-width:640px){body{touch-action:none}}
  </style>
  <script type="module" crossorigin src="./assets/index-Be8Mt7-5.js"></script>
  <link rel="modulepreload" crossorigin href="./assets/pixi-C_DfPwKg.js">
  <link rel="modulepreload" crossorigin href="./assets/scripts-DCp6_Aq5.js">
</head>
<body>
  <div id="cgf-loading" aria-busy="true" aria-label="Cat Goes Fishing is loading">
    <div class="cgf-mark">
      <svg class="cgf-emblem" viewBox="0 0 150 112" fill="none" aria-hidden="true">
        <path d="M29 87c-17 0-19-20-8-27M29 87h45c-14-8-12-26-10-34l-2-27-15 10-16-8-2 27c-9 12-9 24 0 32Z" fill="currentColor"/>
        <path d="M61 49c19-23 46-27 69-20M129 29v47" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="M125 79a4 4 0 0 0 8 0v-3" stroke="#9cb7b8" stroke-width="2" stroke-linecap="round"/>
        <path d="M14 100c11-4 19 4 30 0s19 4 30 0 19 4 30 0 19 4 30 0" stroke="#667b81" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="54" cy="46" r="2" fill="#0b0e11"/>
      </svg>
      <h1 class="cgf-title"><span>Cat Goes</span><em>Fishing</em></h1>
    </div>
    <div class="cgf-progress">
      <div class="cgf-bar" id="cgf-loadbar" role="progressbar" aria-label="Loading the game" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="cgf-fill" id="cgf-loadfill"></div></div>
      <div class="cgf-detail"><p id="cgf-loadtext" role="status" aria-live="polite">Starting the game</p><span class="cgf-percent" id="cgf-loadpercent" aria-hidden="true">0%</span></div>
      <p class="cgf-error" id="cgf-loaderror" role="alert" hidden></p>
      <button class="cgf-retry" id="cgf-retry" type="button" hidden>Reload</button>
    </div>
    <a class="cgf-credit" href="https://store.steampowered.com/app/343780/Cat_Goes_Fishing/" target="_blank" rel="noopener">Cat Goes Fishing on Steam ↗</a>
  </div>
  <script>
    document.getElementById('cgf-retry').addEventListener('click', () => location.reload());
    setTimeout(() => {
      const loader = document.getElementById('cgf-loading');
      if (loader && loader.getAttribute('aria-busy') === 'true') {
        document.getElementById('cgf-loaderror').textContent = 'Still loading. Check your connection or try reloading.';
        document.getElementById('cgf-loaderror').hidden = false;
        document.getElementById('cgf-retry').hidden = false;
      }
    }, 30000);
  </script>
</body>
</html>
